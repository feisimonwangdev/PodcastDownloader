# GitHub Release（托管音频供 ASR 拉取，仓库需为「公开」）
# 默认 feisimonwangdev/PodcastDownloader；如用其他仓库可在此覆盖
GITHUB_REPO=feisimonwangdev/PodcastDownloader
# 可选：仅当未用 gh CLI 登录时需要（gh 已登录可留空）
GITHUB_TOKEN=

# ===== 文本模型（transcript segmentation 用） =====
LLM_API_KEY=change-me
LLM_BASE_URL=https://llm-tvey7rva6yydj3qy.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max-2026-06-08
